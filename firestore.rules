rules_version = '2';

// FIRST REAL PASS — still requires a human to paste this into Firebase
// console > Firestore Database > Rules by hand (no Firebase CLI/service
// account configured for deploys on this Mac). Do NOT apply before
// confirming Stage 1+2 of the Firestore-auth-bridge work are live and a
// real login has been verified to produce request.auth.uid == the app's
// own numeric user id (see GlobalFunction::generateFirebaseCustomToken on
// the Laravel backend, and AuthScreenController._registration() on the
// Flutter side) — applying this against the OLD email/Google/Apple-uid
// sessions would just silently fail every uid-scoped check below.
//
// What changed from the old fully-open draft: every read/write now
// requires request.auth != null (closes the single worst gap — today
// ANY unauthenticated request can write anything) plus real per-user
// scoping for the one collection confirmed to be unambiguously self-
// owned (moderators, below).
//
// What's deliberately NOT yet tightened further, and why: almost every
// other collection in this app has a "sender writes to someone else's
// doc" pattern by design, not a bug — a co-host invite writes
// pending_battle_invite_from_id onto the INVITEE's room doc, not the
// inviter's own, for example. A naive
// "request.auth.uid == resource.data.owner_id" rule on livestreams/,
// user_state/, comments/ would reject these legitimate writes outright —
// exactly the failure mode the original draft of this file warned about.
// Properly tightening those needs each write path mapped field-by-field
// (which fields a non-owner is allowed to touch, and bounding the values,
// e.g. a plausible max per-gift coin delta) rather than one blanket
// identity check — tracked as a real follow-up, not silently left open
// without saying so here.
//
// live_rankings*/leagues/ are the one exception already fully closed
// below: as of 2026-10-25 the coin increments for these three collections
// are written server-side only (GlobalFunction::recordLiveRankingGift on
// the Laravel backend, via a Firestore Admin-scoped OAuth token that
// bypasses these rules entirely, called from WalletController::sendGift
// right after the real gift transaction commits). The client-side
// LiveRankingController.recordGift / HourlyRankingController.recordGift /
// LeagueController.recordGift calls that used to write these directly
// were removed for the same reason -- nothing in the app writes to these
// paths anymore, so clients get read-only access.
//
// livestreams/{roomID}/moderators/ and /moderation_log/ (client spec
// Module 14, redesigned 2026-10-26) are scoped below too: a room's own
// roomID is always identical to its host's numeric user id (set together,
// same `id`, in UserExtension.livestream() -- never two different users),
// so `request.auth.uid == roomID` is the same "only the host" check the
// retired app_users rule below used, just keyed by room instead of by a
// separate hostId segment.
service cloud.firestore {
  match /databases/{database}/documents {

    // RETIRED 2026-10-26 -- the permanent, cross-session moderator list
    // this rule covered (manage_moderators_screen_controller.dart) was
    // replaced by a per-LIVE-session one (see livestreams/{roomID}/
    // moderators/ below), which is what new code reads/writes. Nothing
    // should write here anymore; left in place only so a not-yet-updated
    // client mid-rollout doesn't hard-fail outright.
    match /app_users/{hostId}/moderators/{moderatorUserId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == hostId;
    }

    // Per-LIVE-session Moderator grants (client spec 14.1: "Permissions
    // apply only to the LIVE session for which the Moderator is
    // authorized"). Only the host may grant/revoke -- spec 14.5: "Moderators
    // must not... Assign other Moderators". Every Moderator, and anyone
    // else in the room, can read the list (needed to compute their own
    // canModerate/canManageGuests reactively).
    match /livestreams/{roomID}/moderators/{moderatorUserId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == roomID;
    }

    // Append-only moderation audit trail (client spec 14.5: "record
    // moderation actions in the audit log"). Anyone in the room can create
    // an entry (the host's own actions get logged too in some paths, and
    // this intentionally doesn't re-derive "is this caller actually a
    // moderator" here -- the real gate is in the client methods that call
    // this, e.g. coHostDelete/onInvite/pinComment; a rule strict enough to
    // re-check Moderator status here via get() would need the exact same
    // livestreams/{roomID}/moderators lookup those methods already make).
    // update/delete are never allowed -- an entry can't be edited or
    // erased once written, including by whoever wrote it.
    match /livestreams/{roomID}/moderation_log/{logId} {
      allow read: if request.auth != null && request.auth.uid == roomID;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Daily/hourly/weekly-League LIVE rankings (live_rankings/{day}/hosts/
    // {hostId}, live_rankings_hourly/{hour}/hosts/{hostId}, leagues/
    // {season}/hosts/{hostId}) — read-only for clients. Every write comes
    // from the backend's service-account credentials (see the file-level
    // comment above), which authenticate outside these rules entirely, so
    // denying client writes here cannot break the real write path; it only
    // closes off a client writing a fake coin amount directly to inflate
    // its own rank or force a League promotion.
    match /live_rankings/{day}/hosts/{hostId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /live_rankings_hourly/{hour}/hosts/{hostId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /leagues/{season}/hosts/{hostId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Everything else: authentication required, same as above, but not
    // yet further restricted per-field — see the file-level comment.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
